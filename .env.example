MONGO_URL=mongodb://localhost:27017/???
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# New environment variables here as needed

# ============================================
# S12 Partner Knowledge Update Service Config
# ============================================

# Partner ID for this Partner system
PARTNER_ID=default_partner

# SeaweedFS URL for file storage
SEAWEED_URL=http://localhost:8080

# Identity Service URL for JWT verification
IDENTITY_SERVICE_URL=http://localhost:8000

# JWKS cache TTL in minutes (default: 10)
JWKS_TTL_IN_MINUTES=10

# A33 API Queue Names (S12 -> S11 for snapshots)
SNAPSHOT_REQUESTS_QUEUE_NAME=snapshot_requests
SNAPSHOT_RESPONSES_QUEUE_NAME=snapshot_responses

# A34 API Queue Name (S12 -> S05 for validation events)
UPDATE_VALIDATION_EVENT_QUEUE=update_validation_events

FLASK_HOST=0.0.0.0
FLASK_PORT=5012
